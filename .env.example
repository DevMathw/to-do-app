# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env

# OBLIGATORIA. Sin ella la aplicación no arranca (y así debe ser: nunca
# debe existir una clave por defecto en producción).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexión a la base de datos.
#   Desarrollo:  sqlite:///./todo.db
#   Producción:  postgresql+psycopg://usuario:password@host:5432/basedatos
DATABASE_URL=sqlite:///./todo.db

# Orígenes permitidos por CORS, separados por comas. Nunca "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Coste de bcrypt. 12 en producción; los tests lo bajan a 4.
BCRYPT_ROUNDS=12

# development | production | test
ENVIRONMENT=development
